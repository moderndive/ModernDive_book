{
  "version": "0.2",
  "language": "en",
  "dictionaries": [
    "en_US",
    "softwareTerms",
    "fonts",
    "filetypes",
    "moderndive"
  ],
  "dictionaryDefinitions": [
    {
      "name": "moderndive",
      "path": "./.cspell-wordlist.txt",
      "addWords": true
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/.quarto/**",
    "**/_freeze/**",
    "**/docs/**",
    "**/_site/**",
    "**/renv/**",
    "**/previous_versions/**",
    "**/ModernDive_cache/**",
    "**/ModernDive_files/**",
    "**/93-appendixC_cache/**",
    "**/93-appendixC_files/**",
    "**/*.html",
    "**/*.css",
    "**/*.lock",
    "_quarto.yml",
    "exercises/*-solutions.yml",
    "**/*.bib",
    "**/*.lua",
    "**/*.pl",
    "**/.github/**",
    "**/exercise-solutions/**",
    "**/instructor-solutions/**"
  ],
  "ignoreRegExpList": [
    "/\\\\b[a-z]+_[a-z_]+\\\\b/",
    "/`[^`]+`/",
    "/\\\\$[^$]+\\\\$/",
    "/https?:\\\\/\\\\/[^\\s]+/",
    "/@[a-zA-Z0-9_-]+/",
    "/#sec-[a-zA-Z0-9_-]+/",
    "/\\\\\\\\index\\\\{[^}]+\\\\}/",
    "/hash: \"?[a-z0-9]{4}\"?/",
    "/\\*\\*[A-Z]\\*\\*[a-z]+/"
  ],
  "allowCompoundWords": true,
  "minWordLength": 4,
  "words": [
    "ANOVA",
    "anova",
    "Benjamini",
    "categoricals",
    "coef",
    "doesn",
    "Explosivity",
    "exponentiate",
    "fstatistic",
    "ggplotly",
    "ggsave",
    "Hochberg",
    "lubridate",
    "nrow",
    "plotly",
    "pvals",
    "rbind",
    "readxl",
    "relevel",
    "rlnorm",
    "rmse",
    "RMSE",
    "rmses",
    "rnorm",
    "samp",
    "sdlog",
    "sprintf",
    "sqft",
    "Stratovolcanoes",
    "stratovolcanoes",
    "tidiers",
    "tribble",
    "tvmaze",
    "ungroup",
    "vball",
    "viridis",
    "vline",
    "wbre",
    "wday",
    "weren",
    "xbar",
    "xintercept",
    "ylim"
  ]
}