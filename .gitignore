# Quarto render artifacts (defensive — solution qmds now live under
# instructor-solutions/chapters/; this guards against accidental re-creation
# if anyone hand-renders one of them standalone).
exercise-solutions/

# Other files
.httr-oauth
*rsconnect/
copy_pdf_to_google_drive.R

# Comment out (and thus do not ignore these files) only when version bumping
# the release branch
docs/*
bib/packages.bib

# Instructor-only resources now live in the PRIVATE companion repo
# moderndive-instructor-resources. The instructor-solutions/ hub and the
# scripts/build_*.R generators were removed from this public repo (2026-06).
# sync_to_book.sh / CI in the companion repo restore them into this working
# tree to render the hub; these patterns keep them from being re-committed here.
/instructor-solutions/
/scripts/build_*.R
/scripts/audit_accessibility.R

# Per-chapter solution YAMLs are instructor-only — keep them off the public repo.
# The public exercises/NN.yml files contain prompts/sections/webr code only;
# `R/exercise_helpers.R` falls back to "[solution withheld]" placeholders if the
# private NN-solutions.yml file is absent (e.g., a student clone).
exercises/*-solutions.yml

# Ignore Quarto's transient project state but keep the freeze cache,
# which encodes per-chapter knit results so CI can skip re-execution.
/.quarto/*
!/.quarto/_freeze/
!/.quarto/_freeze/**
# Cocoa file API auto-suffixes "<name> 2.png", "<name> 3.png", etc. when
# Quarto's render races on file creation. They're always duplicates of
# the un-suffixed original — never track them.
/.quarto/_freeze/**/* [0-9].*
**/*.quarto_ipynb

































